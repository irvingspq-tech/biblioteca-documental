name: Actualizar y publicar biblioteca

on:
  schedule:
    - cron: "*/15 * * * *"   # cada 15 minutos (GitHub puede retrasarlo unos minutos)
  workflow_dispatch:          # botón "Run workflow" para actualizar al momento
  push:
    branches: [main]

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  publicar:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.despliegue.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Escanear SharePoint y armar el sitio
        run: |
          mkdir _site
          python scripts/escanear.py _site/biblioteca.json
          cp biblioteca-opcion-1.html _site/index.html
      - name: Mantener activo el programador (GitHub lo apaga tras 60 días sin actividad)
        if: github.event_name == 'schedule'
        run: |
          ultimo=$(git log -1 --format=%ct); ahora=$(date +%s)
          if [ $((ahora - ultimo)) -gt 3888000 ]; then
            git config user.name "biblioteca-bot"; git config user.email "bot@users.noreply.github.com"
            git commit --allow-empty -m "Mantener activo el programador"; git push
          fi
      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site
      - id: despliegue
        uses: actions/deploy-pages@v4
